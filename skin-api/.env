# Bat Client hosted skin API ? environment config.
# Copy to /var/www/skin-api/.env on the VM and fill in a strong token.
BAT_SKIN_HOST=127.0.0.1
BAT_SKIN_PORT=8090
BAT_SKIN_DATA_DIR=/var/www/skin-api/data
BAT_SKIN_KEY_DIR=/var/www/skin-api/keys
BAT_SKIN_BASE_URL=https://batclient.xyz/skinapi
BAT_SKIN_API_ROOT=https://batclient.xyz/skinapi/api/yggdrasil
# REQUIRED: shared secret the launcher uses for uploads (match in launcher setting).
BAT_SKIN_UPLOAD_TOKEN=4EhF5bCPKoaeL0ulXdifRcvzWZ3mOGygTpsY9IVQU78wjxBA
